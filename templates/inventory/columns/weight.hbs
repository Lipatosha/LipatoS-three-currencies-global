<div class="item-detail item-weight lps-centered-column {{#unless ctx.totalWeight}}empty{{/unless}}" data-column-id="weight">
    {{#if ctx.totalWeight}}
    <span class="lps-center-anchor">
        <span class="lps-main-value">{{ ctx.totalWeight }}</span>
        <span class="lps-inline-icon lps-weight-inline-icon" aria-hidden="true">
            <i class="fa-solid fa-weight-hanging" inert></i>
        </span>
    </span>
    {{/if}}
</div>
