<div class="item-detail item-weight lps-value-icon-column {{#unless ctx.totalWeight}}empty{{/unless}}" data-column-id="weight">
    {{#if ctx.totalWeight}}
    <span class="lps-mirror-slot" aria-hidden="true"></span>
    <span class="lps-main-value">{{ ctx.totalWeight }}</span>
    <span class="lps-icon-slot lps-weight-icon-slot" aria-hidden="true">
        <i class="fa-solid fa-weight-hanging" inert></i>
    </span>
    {{/if}}
</div>
