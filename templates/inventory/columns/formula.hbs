<div class="item-detail item-formula lps-formula-column {{#unless entry.labels.damages.length}}empty{{/unless}}" data-column-id="formula">
    {{#each entry.labels.damages}}
    {{#unless (eq firstDamage false)}}
    <span class="lps-formula-layout">
        <span class="lps-mirror-slot" aria-hidden="true"></span>
        <span class="formula lps-main-value">{{ formula }}</span>
        {{#with (lookup @root.labels.damageAndHealing damageType)}}
        <span class="lps-icon-slot lps-damage-icon-slot" data-tooltip aria-label="{{ label }}">
            <dnd5e-icon src="{{ icon }}"></dnd5e-icon>
        </span>
        {{else}}
        <span class="lps-icon-slot" aria-hidden="true"></span>
        {{/with}}
    </span>
    {{/unless}}
    {{/each}}
</div>
