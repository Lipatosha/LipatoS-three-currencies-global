<div class="item-detail item-formula lps-centered-column {{#unless entry.labels.damages.length}}empty{{/unless}}" data-column-id="formula">
    {{#each entry.labels.damages}}
    {{#unless (eq firstDamage false)}}
    <span class="lps-center-anchor lps-formula-anchor">
        <span class="formula lps-main-value">{{ formula }}</span>
        {{#with (lookup @root.labels.damageAndHealing damageType)}}
        <span class="lps-inline-icon lps-damage-inline-icon" data-tooltip aria-label="{{ label }}">
            <dnd5e-icon src="{{ icon }}"></dnd5e-icon>
        </span>
        {{/with}}
    </span>
    {{/unless}}
    {{/each}}
</div>
