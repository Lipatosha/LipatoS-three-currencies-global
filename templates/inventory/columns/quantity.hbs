<div class="item-detail item-quantity lps-quantity-column {{#unless isItem}}empty{{/unless}}" data-column-id="quantity">
    {{#if isItem}}
    <span class="lps-qty-anchor">
        {{#if @root.locked}}
        <span class="value lps-qty-value">{{ entry.system.quantity }}</span>
        {{else}}
        <a class="adjustment-button always-interactive lps-qty-minus" data-action="decrease" data-property="system.quantity">
            <i class="fa-solid fa-minus" inert></i>
        </a>
        <input type="text" class="always-interactive lps-qty-value" value="{{ entry.system.quantity }}" placeholder="0"
               data-dtype="Number" data-name="system.quantity" inputmode="numeric" pattern="^[+=\-]?\d*" min="0"
               aria-label="{{ localize "DND5E.Quantity" }}">
        <a class="adjustment-button always-interactive lps-qty-plus" data-action="increase" data-property="system.quantity">
            <i class="fa-solid fa-plus" inert></i>
        </a>
        {{/if}}
    </span>
    {{/if}}
</div>
