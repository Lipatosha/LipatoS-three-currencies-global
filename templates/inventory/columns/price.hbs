<div class="item-detail item-price lps-balanced-column {{#unless entry.system.price.value}}empty{{/unless}}" data-column-id="price">
    {{#if entry.system.price.value}}
    <span class="lps-balanced-value">
        <span class="lps-balance-spacer" aria-hidden="true"></span>
        <span class="lps-column-value">{{ifThen ctx.concealDetails "—" (dnd5e-numberFormat entry.system.price.value)}}</span>
        <i class="currency {{ entry.system.price.denomination }} lps-column-icon"
           aria-label="{{ lookup (lookup @root.config.currencies entry.system.price.denomination) "label" }}"></i>
    </span>
    {{/if}}
</div>
